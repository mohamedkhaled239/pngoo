platform :ios, '15.0'

ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(
    File.join('..', 'Flutter', 'Generated.xcconfig'),
    __FILE__,
  )
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. Run flutter pub get first."
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}"
end

require File.expand_path(
  File.join('packages', 'flutter_tools', 'bin', 'podhelper'),
  flutter_root,
)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    # Older BoringSSL-GRPC podspecs add
    # -GCC_WARN_INHIBIT_ALL_WARNINGS as a per-file compiler flag. Xcode 16+
    # parses its `-G` prefix as an unsupported target option. Remove only that
    # obsolete warning flag while preserving every other compiler setting.
    if target.name == 'BoringSSL-GRPC'
      target.source_build_phase.files.each do |file|
        next unless file.settings && file.settings['COMPILER_FLAGS']

        compiler_flags = file.settings['COMPILER_FLAGS'].split
        compiler_flags.delete('-GCC_WARN_INHIBIT_ALL_WARNINGS')
        file.settings['COMPILER_FLAGS'] = compiler_flags.join(' ')
      end
    end

    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end

  # Firebase 10.x resolves an older gRPC-Core whose dependent template call is
  # rejected by the stricter Clang shipped with Xcode 16.3+. Apply the
  # standards-compliant empty template argument list after every pod install.
  grpc_basic_seq_files = Dir.glob(
    File.expand_path(
      File.join(
        'Pods',
        'gRPC-*',
        'src',
        'core',
        'lib',
        'promise',
        'detail',
        'basic_seq.h',
      ),
      __dir__,
    ),
  )
  if grpc_basic_seq_files.empty?
    puts 'No legacy gRPC basic_seq.h files found; no template patch is needed.'
  end

  old_factory_call = 'Traits::template CallSeqFactory('
  fixed_factory_call = 'Traits::template CallSeqFactory<>('
  grpc_basic_seq_files.each do |grpc_basic_seq_file|
    grpc_source = File.read(grpc_basic_seq_file)

    if grpc_source.include?(old_factory_call)
      File.write(
        grpc_basic_seq_file,
        grpc_source.gsub(old_factory_call, fixed_factory_call),
      )
      puts "Patched #{grpc_basic_seq_file} for Xcode template parsing."
    elsif grpc_source.include?(fixed_factory_call)
      puts "Verified #{grpc_basic_seq_file} already contains the Xcode template fix."
    else
      raise "Unsupported gRPC basic_seq.h layout: #{grpc_basic_seq_file}"
    end
  end

  awesome_pod_file = File.expand_path(
    File.join(
      'plugins',
      'awesome_notifications',
      'ios',
      'Scripts',
      'AwesomePodFile',
    ),
    '.symlinks',
  )
  require awesome_pod_file
  update_awesome_pod_build_settings(installer)
end

awesome_pod_file = File.expand_path(
  File.join(
    'plugins',
    'awesome_notifications',
    'ios',
    'Scripts',
    'AwesomePodFile',
  ),
  '.symlinks',
)
require awesome_pod_file
update_awesome_main_target_settings(
  'Runner',
  File.dirname(File.realpath(__FILE__)),
  flutter_root,
)
